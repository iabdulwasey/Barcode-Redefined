# SCANVAS Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SCANVAS

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic Claude API ──────────────────────────────────────────────────
# Used for: AI shape generation, brand color matching
ANTHROPIC_API_KEY=sk-ant-...

# ─── Replicate API ─────────────────────────────────────────────────────────
# Used for: AI QR art generation (Flux ControlNet)
REPLICATE_API_TOKEN=r8_...

# ─── Stripe ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_API_USAGE=price_...

# ─── Storage ───────────────────────────────────────────────────────────────
# Cloudflare R2 or use Supabase Storage (set STORAGE_PROVIDER=supabase)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=scanvas-assets

# Cloudflare R2 (if using R2 instead of Supabase Storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ─── PostHog Analytics ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
